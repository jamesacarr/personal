{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["dom", "es2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@/components/*": ["./src/components/*"],
      "@/contact/*": ["./src/contact/*"]
    },
    "plugins": [{ "name": "next" }],
    "preserveConstEnums": true,
    "removeComments": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "ES2023"
  },
  "exclude": ["node_modules"],
  "include": [
    ".next/dev/types/**/*.ts",
    ".next/types/**/*.ts",
    "src/**/*.ts*",
    "vitest",
    "./*.ts"
  ]
}
